---
import { ui, path, content, cvPdf, type Lang } from '../i18n';
interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const t = ui[lang].pal;
const { projects, person, cases, trackLabel } = content(lang);
const home = path(lang, '/');

type Item = { group: string; label: string; hint: string; href?: string; action?: string };
const items: Item[] = [
  { group: t.goto, label: t.work, hint: t.section, href: `${home}#work` },
  { group: t.goto, label: t.index, hint: t.section, href: `${home}#index` },
  { group: t.goto, label: t.toolbox, hint: t.section, href: `${home}#toolbox` },
  { group: t.goto, label: t.about, hint: t.section, href: `${home}#about` },
  { group: t.goto, label: t.services, hint: t.section, href: `${home}#services` },
  { group: t.goto, label: t.contact, hint: t.section, href: `${home}#contact` },
  { group: t.goto, label: t.security, hint: t.page, href: path(lang, '/security') },
  ...cases.map((c) => ({ group: t.cases, label: c.title, hint: c.id, href: path(lang, `/work/${c.slug}`) })),
  ...projects.filter((p) => !p.slug).map((p) => ({ group: t.projects, label: p.title, hint: trackLabel[p.track], href: p.href ?? `${home}#index` })),
  { group: t.actions, label: t.openCv, hint: t.page, href: path(lang, '/cv') },
  { group: t.actions, label: t.dlCv, hint: 'pdf', href: cvPdf(lang) },
  { group: t.actions, label: t.copy, hint: person.email, action: 'copy-email' },
  { group: t.actions, label: t.lang, hint: lang === 'fr' ? 'EN' : 'FR', href: altHref },
  { group: t.actions, label: t.gh, hint: t.external, href: person.github },
  { group: t.actions, label: t.li, hint: t.external, href: person.linkedin },
];
---
<dialog data-palette aria-label="Command palette" class="m-auto mt-[12vh] w-[min(640px,calc(100vw-32px))] overflow-hidden rounded-2xl border border-line-2 bg-[#0d110f] p-0 text-fg shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm">
  <div class="flex items-center gap-3 border-b border-line px-4">
    <span class="font-mono text-accent" aria-hidden="true">$</span>
    <label for="palette-input" class="sr-only">{t.inputLabel}</label>
    <input id="palette-input" data-palette-input type="text" autocomplete="off" spellcheck="false" placeholder={t.placeholder} class="h-14 w-full bg-transparent font-mono text-[15px] text-fg placeholder:text-faint focus:outline-none" />
    <kbd class="rounded border border-[#2a332e] px-1.5 py-0.5 font-mono text-[11px] text-dim">Esc</kbd>
  </div>
  <ul data-palette-list role="listbox" aria-label={t.results} class="max-h-[50vh] overflow-y-auto p-2">
    {items.map((it) => (
      <li role="option" aria-selected="false" data-item data-text={`${it.label} ${it.hint} ${it.group}`.toLowerCase()} data-href={it.href} data-action={it.action}
        class="flex min-h-11 cursor-pointer items-center justify-between gap-4 rounded-lg px-3 py-2 text-[15px] text-fg-2 aria-selected:bg-[#17200f] aria-selected:text-fg">
        <span class="flex items-center gap-3"><span class="w-20 shrink-0 font-mono text-[11px] uppercase text-faint">{it.group}</span>{it.label}</span>
        <span class="truncate font-mono text-xs text-faint">{it.hint}</span>
      </li>
    ))}
  </ul>
  <p data-palette-empty hidden class="px-5 py-8 text-center font-mono text-sm text-faint">{t.empty}</p>
  <p class="border-t border-line px-4 py-2.5 font-mono text-[11px] text-faint">{t.help}</p>
</dialog>
