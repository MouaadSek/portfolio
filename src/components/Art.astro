---
// Code-drawn cover art for each case study. No stock images, no screenshots needed.
import type { Art } from '../data/cases';
interface Props { type: Art; large?: boolean }
const { type, large = false } = Astro.props;
const scale = large ? 'scale-[.62] @[480px]:scale-90 @[760px]:scale-110 @[1000px]:scale-125' : 'scale-[.6] @[420px]:scale-[.72] @[560px]:scale-[.85] @[760px]:scale-95';

const scores = [
  { name: 'Samsonite Proxis 55', score: 8.9, w: 'w-[89%]' },
  { name: 'American Tourister SoundBox 55', score: 8.5, w: 'w-[85%]' },
  { name: 'RIMOWA Essential Cabin', score: 7.8, w: 'w-[78%]' },
];
const sources = ['France Travail', 'Welcome to the Jungle', 'HelloWork', 'LinkedIn alert'];
const vlans = [
  { id: 10, name: 'Admin', net: '10.10.10.0/24' },
  { id: 20, name: 'Employees', net: '10.10.20.0/24' },
  { id: 30, name: 'Servers', net: '10.10.30.0/24' },
  { id: 40, name: 'DMZ', net: '10.10.40.0/24' },
  { id: 50, name: 'Guests', net: '10.10.50.0/24' },
];
// 5x5 grid, row 0 = high impact. Cells: [row, col, label, level]
const risks: Record<string, string> = { '0-3': 'R1', '1-3': 'R2', '1-2': 'R3 R4', '2-2': 'R5 R6 R7', '3-2': 'R8 R9', '2-1': 'R10' };
const heat = (r: number, c: number) => {
  const v = (4 - r) + c;
  return v >= 6 ? 'bg-[#3a1d14]' : v >= 4 ? 'bg-[#2e2410]' : v >= 2 ? 'bg-[#1a2214]' : 'bg-[#121714]';
};
---
<div class="@container relative flex h-full w-full items-center justify-center overflow-hidden bg-[#0b0e0c]">
  <div class="dots-bg absolute inset-0" aria-hidden="true"></div>
  <div class={`relative ${scale} transition-transform`} aria-hidden="true">

    {type === 'scorecard' && (
      <div class="w-[340px] rounded-2xl border border-line-2 bg-panel p-5 shadow-2xl">
        <div class="mb-4 flex items-center justify-between">
          <span class="font-mono text-[11px] text-faint">CABIN LUGGAGE · SCORE MODEL v1</span>
          <span class="rounded bg-[#1e1708] px-2 py-0.5 font-mono text-[10px] text-amber">RESEARCH</span>
        </div>
        <div class="flex flex-col gap-3.5">
          {scores.map((s) => (
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between text-[13px]"><span class="text-fg-2">{s.name}</span><span class="font-mono text-accent">{s.score}</span></div>
              <div class="h-1.5 overflow-hidden rounded-full bg-[#1a201c]"><div class={`h-full rounded-full bg-accent ${s.w}`}></div></div>
            </div>
          ))}
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-line pt-3 font-mono text-[10px] text-faint">
          <span>weights = 100% ✓</span><span>sources cited ✓</span><span>/go/[token]</span>
        </div>
      </div>
    )}

    {type === 'pipeline' && (
      <div class="flex items-center gap-2">
        {['commit', 'trivy', 'registry', 'cluster'].map((n, i) => (
          <>
            <div class={`flex w-[92px] flex-col items-center gap-2 rounded-xl border p-3 ${n === 'trivy' ? 'border-[#5a2a1a] bg-[#1d110c]' : 'border-line-2 bg-panel'}`}>
              <span class={`font-mono text-[11px] ${n === 'trivy' ? 'text-[#ff8a5c]' : 'text-fg-2'}`}>{n}</span>
              <span class={`font-mono text-[9px] ${n === 'trivy' ? 'text-[#ff8a5c]' : i > 1 ? 'text-faint' : 'text-accent'}`}>{n === 'trivy' ? 'BLOCKED' : i > 1 ? 'never reached' : 'ok'}</span>
            </div>
            {i < 3 && <svg width="26" height="10" viewBox="0 0 26 10"><path d="M0 5h22" stroke={i === 0 ? '#b8f25a' : '#2a352f'} stroke-width="2" class={i === 0 ? 'flow-line' : ''}></path><path d="M18 1l4 4-4 4" stroke={i === 0 ? '#b8f25a' : '#2a352f'} stroke-width="2" fill="none"></path></svg>}
          </>
        ))}
        <div class="absolute -bottom-12 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md border border-[#5a2a1a] bg-[#1d110c] px-3 py-1.5 font-mono text-[11px] text-[#ff8a5c]">CRITICAL CVE found · push cancelled</div>
      </div>
    )}

    {type === 'funnel' && (
      <div class="flex items-center gap-4">
        <div class="flex flex-col gap-2">
          {sources.map((s) => (
            <div class="flex w-[200px] items-center justify-between rounded-lg border border-line-2 bg-panel px-3 py-2">
              <span class="text-[12px] text-fg-2">{s}</span><span class="font-mono text-[10px] text-faint">posting</span>
            </div>
          ))}
        </div>
        <svg width="40" height="150" viewBox="0 0 40 150"><path d="M0 18 C 25 18, 15 75, 40 75 M0 56 C 25 56, 15 75, 40 75 M0 94 C 25 94, 15 75, 40 75 M0 132 C 25 132, 15 75, 40 75" stroke="#b8f25a" stroke-width="1.5" fill="none" class="flow-line"></path></svg>
        <div class="flex w-[150px] flex-col gap-2 rounded-xl border border-accent bg-[#131a10] p-3">
          <span class="font-mono text-[10px] text-accent">1 OFFER</span>
          <span class="text-[13px] text-fg">Cloud Security intern</span>
          <span class="font-mono text-[10px] text-dim">3 duplicates merged</span>
          <span class="mt-1 rounded bg-accent px-2 py-1 text-center font-mono text-[10px] text-ink">CV tailored</span>
        </div>
      </div>
    )}

    {type === 'bistro' && (
      <div class="flex items-start gap-4">
        <div class="w-[230px] rounded-2xl border border-line-2 bg-[#14110d] p-4">
          <span class="font-display text-xl text-[#f3e6d0]">L'Adress</span>
          <span class="block font-mono text-[10px] text-[#a8957a]">BISTROT · LILLE</span>
          <div class="mt-4 flex flex-col gap-2">
            {[['Date', 'Sat 18 Oct'], ['Guests', '4'], ['Time', '20:30']].map(([k, v]) => (
              <div class="flex justify-between rounded-md border border-[#2e281f] px-2.5 py-1.5 text-[12px]"><span class="text-[#a8957a]">{k}</span><span class="text-[#f3e6d0]">{v}</span></div>
            ))}
          </div>
          <div class="mt-3 rounded-md bg-[#d9a45b] py-1.5 text-center text-[12px] font-semibold text-[#14110d]">Réserver</div>
        </div>
        <div class="mt-6 flex flex-col gap-2 font-mono text-[11px]">
          {['zod schema', 'rate limit', 'RLS policy', 'owner email'].map((c) => (
            <span class="flex items-center gap-2 rounded-md border border-line-2 bg-panel px-2.5 py-1.5 text-fg-2"><span class="text-accent">✓</span>{c}</span>
          ))}
        </div>
      </div>
    )}

    {type === 'riskgrid' && (
      <div class="flex items-end gap-3">
        <span class="mb-16 -rotate-90 font-mono text-[10px] text-faint">IMPACT</span>
        <div class="flex flex-col gap-2">
          <div class="grid grid-cols-5 gap-1.5">
            {[0, 1, 2, 3, 4].map((r) => [0, 1, 2, 3, 4].map((c) => (
              <div class={`flex h-11 w-[58px] items-center justify-center rounded-md border border-[#1c231f] font-mono text-[10px] ${heat(r, c)} ${risks[`${r}-${c}`] ? 'text-fg' : 'text-transparent'}`}>{risks[`${r}-${c}`] ?? '·'}</div>
            )))}
          </div>
          <span class="text-center font-mono text-[10px] text-faint">LIKELIHOOD</span>
        </div>
        <div class="mb-8 ml-2 flex flex-col gap-1.5 font-mono text-[10px]">
          <span class="flex items-center gap-2 text-fg-2"><span class="h-2.5 w-2.5 rounded-sm bg-[#3a1d14]"></span>critical</span>
          <span class="flex items-center gap-2 text-fg-2"><span class="h-2.5 w-2.5 rounded-sm bg-[#2e2410]"></span>high</span>
          <span class="flex items-center gap-2 text-fg-2"><span class="h-2.5 w-2.5 rounded-sm bg-[#1a2214]"></span>medium</span>
        </div>
      </div>
    )}

    {type === 'vlans' && (
      <div class="flex flex-col items-center gap-3">
        <div class="flex items-center gap-2 rounded-xl border border-accent bg-[#131a10] px-4 py-2 font-mono text-[11px] text-accent">nftables · policy drop · Suricata</div>
        <svg width="420" height="26" viewBox="0 0 420 26"><path d="M210 0v10M42 10h336M42 10v16M126 10v16M210 10v16M294 10v16M378 10v16" stroke="#2e3a33" stroke-width="1.5" fill="none"></path></svg>
        <div class="flex gap-2">
          {vlans.map((v) => (
            <div class="flex w-[78px] flex-col items-center gap-1 rounded-lg border border-line-2 bg-panel px-1.5 py-2.5">
              <span class="font-mono text-[10px] text-accent">VLAN {v.id}</span>
              <span class="text-[12px] text-fg">{v.name}</span>
              <span class="font-mono text-[8px] text-faint">{v.net}</span>
            </div>
          ))}
        </div>
        <span class="font-mono text-[10px] text-faint">802.1X + RADIUS on every access port</span>
      </div>
    )}
  </div>
  {large && <div class="scanline pointer-events-none absolute inset-x-0 top-0 h-1/4 bg-gradient-to-b from-transparent via-accent/[.04] to-transparent" aria-hidden="true"></div>}
</div>
