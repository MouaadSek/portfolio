---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { person, projects, tracks, toolbox, timeline, stats } from '../data/site';
import { cases } from '../data/cases';

const spans = ['lg:col-span-4', 'lg:col-span-2', 'lg:col-span-2', 'lg:col-span-4', 'lg:col-span-3', 'lg:col-span-3'];
const filters = ['All', ...tracks.map((t) => t.key)];
const proofClass: Record<string, string> = { Live: 'text-amber', Repo: 'text-accent', Report: 'text-fg-2', Brief: 'text-fg-2' };
const arrow = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
const ext = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"></path></svg>';
---
<Base>
  <!-- HERO -->
  <section class="relative overflow-hidden" id="top">
    <div class="grid-bg pointer-events-none absolute inset-0 h-[900px]" aria-hidden="true"></div>
    <div class="wrap relative flex flex-wrap items-center gap-14 pb-24 pt-16 sm:pt-20">
      <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-7">
        <p class="inline-flex items-center gap-2.5 self-start rounded-full border border-line-2 bg-[#0f1411] px-3.5 py-2 font-mono text-[13px] text-fg-2">
          <span class="pulse-dot h-2 w-2 shrink-0 rounded-full bg-accent"></span>{person.availability}
        </p>
        <h1 class="font-display text-[clamp(48px,7vw,104px)] font-extrabold leading-[.95] tracking-[-0.03em]">
          I secure systems.<br />I <span class="text-accent">ship</span> them too.
        </h1>
        <p class="max-w-[640px] text-xl leading-relaxed text-muted">
          Mouaad Sekkouri. M2 Cybersecurity at SUPINFO Lille, heading for Cloud Security and DevSecOps. Four years in IT, 19 projects from Kubernetes admission control to a product live in production.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a href="#contact" class="btn-primary">Hire me <Fragment set:html={arrow} /></a>
          <a href="#services" class="btn-ghost">Work with me</a>
          <a href="/Mouaad-Sekkouri-CV.pdf" class="btn px-3 font-normal text-muted hover:text-fg" download>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>CV (PDF)
          </a>
        </div>
      </div>

      <div class="min-w-0 flex-[1_1_400px] overflow-hidden rounded-[18px] border border-[#1f2622] bg-[#0e1210] shadow-[0_40px_80px_-30px_rgba(0,0,0,.8)]">
        <div class="flex items-center gap-2 border-b border-[#1a201c] px-4 py-3.5">
          <span class="h-[11px] w-[11px] rounded-full bg-[#2a332e]"></span><span class="h-[11px] w-[11px] rounded-full bg-[#2a332e]"></span><span class="h-[11px] w-[11px] rounded-full bg-[#2a332e]"></span>
          <span class="ml-2.5 font-mono text-xs text-faint">soc-console / whoami</span>
        </div>
        <div class="px-5 pb-6 pt-5 font-mono text-[14px] leading-[1.85] text-fg-2">
          <div><span class="text-accent">$</span> <span data-type="whoami --verbose">whoami --verbose</span></div>
          <dl class="grid grid-cols-[88px_1fr]">
            <dt class="text-faint">name</dt><dd>{person.name}</dd>
            <dt class="text-faint">role</dt><dd>{person.role}</dd>
            <dt class="text-faint">base</dt><dd>Lille, FR (Belgium-ready)</dd>
            <dt class="text-faint">langs</dt><dd>FR, EN (C1), AR, DE (A2)</dd>
            <dt class="text-faint">stack</dt><dd>K8s, Azure, GitLab CI, Next.js</dd>
            <dt class="text-faint">certs</dt><dd>AZ-900</dd>
          </dl>
          <div class="mt-2.5"><span class="text-accent">$</span> status</div>
          <div><span class="text-amber">[LIVE]</span> travistello in production</div>
          <div><span class="text-dim">[DONE]</span> internship @ Baïfall Dream</div>
          <div><span class="text-accent">[OPEN]</span> stage, Mar 2027, 6 months</div>
          <div class="mt-2.5"><span class="text-accent">$</span> <span class="caret"></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section aria-label="Key numbers" class="border-y border-[#1a201c] bg-panel-2">
    <div class="wrap grid grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class={`flex flex-col gap-1.5 py-9 ${i % 2 ? 'border-l border-[#1a201c] pl-6' : 'pr-6'} ${i === 2 ? 'lg:border-l lg:pl-6' : ''} ${i > 1 ? 'border-t border-[#1a201c] lg:border-t-0' : ''}`}>
          <span class="font-display text-[clamp(36px,4vw,48px)] font-extrabold"><span data-count={s.value}>{s.value.toLocaleString('en-US')}</span><span class="text-accent">{s.suffix}</span></span>
          <span class="text-[15px] text-dim">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- TRACKS -->
  <section class="wrap flex flex-col gap-10 pt-28">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="flex flex-col gap-3.5">
        <span class="eyebrow">01 / COVERAGE</span>
        <h2 class="h2">Break it. Harden it. Ship it.</h2>
      </div>
      <p class="max-w-[440px] text-[17px] leading-relaxed text-muted">Most security students only have labs. I also build and run real products, so I know what securing them costs the team that ships.</p>
    </div>
    <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
      {tracks.map((t) => {
        const count = projects.filter((p) => p.track === t.key).length;
        return (
          <div class="reveal spot card flex flex-col gap-4 p-6">
            <div class="flex items-center justify-between font-mono text-xs"><span class="text-faint">{t.code}</span><span class="text-muted">{count} projects</span></div>
            <span class="font-display text-2xl font-semibold">{t.name}</span>
            <span class="text-[15px] leading-relaxed text-muted">{t.desc}</span>
            <div class="mt-auto h-1.5 overflow-hidden rounded-full bg-[#1a201c]"><div class={`h-full rounded-full bg-accent ${t.bar}`}></div></div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- FEATURED -->
  <section id="work" class="wrap flex scroll-mt-20 flex-col gap-10 pt-28">
    <div class="reveal flex flex-col gap-3.5">
      <span class="eyebrow">02 / CASE FILES</span>
      <h2 class="h2 max-w-[900px]">Selected work, written like incident reports.</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-6">
      {cases.map((c, i) => (
        <a href={`/work/${c.slug}`} class={`reveal spot card group flex flex-col text-fg ${spans[i]}`}>
          <div class="relative h-64 border-b border-line">
            <Art type={c.art} />
            <span class="absolute left-4 top-4 rounded-md border border-line-2 bg-[#151b17] px-2.5 py-1 font-mono text-xs text-accent">{c.id}</span>
            {c.live && <span class="absolute right-4 top-4 flex items-center gap-2 rounded-md border border-[#3a2c10] bg-[#1e1708] px-2.5 py-1 font-mono text-xs text-amber"><span class="h-[7px] w-[7px] rounded-full bg-amber"></span>LIVE</span>}
          </div>
          <div class="flex flex-1 flex-col gap-3 p-6">
            <span class="font-mono text-xs text-dim">{c.track}</span>
            <h3 class="font-display text-[26px] font-semibold leading-tight">{c.title}</h3>
            <p class="text-[15px] leading-relaxed text-muted">{c.summary}</p>
            <div class="mt-1 flex flex-wrap gap-2">{c.tags.map((t) => <span class="chip">{t}</span>)}</div>
            <span class="mt-auto flex items-center gap-2 pt-3 text-[15px] font-medium text-accent">Read the case file <span class="transition-transform group-hover:translate-x-1"><Fragment set:html={arrow} /></span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- INDEX -->
  <section id="index" class="wrap flex scroll-mt-20 flex-col gap-7 pt-24">
    <div class="reveal flex flex-wrap items-end justify-between gap-5">
      <div class="flex flex-col gap-3.5">
        <span class="eyebrow">03 / FULL INDEX</span>
        <h2 class="font-display text-[clamp(30px,3.6vw,48px)] font-extrabold leading-none tracking-[-0.02em]">All projects</h2>
      </div>
      <span class="font-mono text-[13px] text-dim">showing <span data-shown>{projects.length}</span> / {projects.length}</span>
    </div>
    <div role="group" aria-label="Filter projects by track" class="flex flex-wrap gap-2.5">
      {filters.map((f, i) => (
        <button type="button" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'} class="min-h-11 cursor-pointer rounded-full border border-line-2 bg-panel px-4 text-sm font-medium text-fg-2 transition-colors hover:border-[#3a4a40] aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-ink">{f}</button>
      ))}
    </div>
    <div class="overflow-x-auto rounded-2xl border border-line">
      <table class="w-full min-w-[780px] border-collapse text-left text-[15px]">
        <caption class="sr-only">All projects with track, stack and proof</caption>
        <thead class="bg-panel-2 font-mono text-xs text-faint">
          <tr class="border-b border-line"><th scope="col" class="w-[80px] px-5 py-3.5 font-normal">ID</th><th scope="col" class="px-5 py-3.5 font-normal">PROJECT</th><th scope="col" class="px-5 py-3.5 font-normal">TRACK</th><th scope="col" class="px-5 py-3.5 font-normal">STACK</th><th scope="col" class="w-[110px] px-5 py-3.5 font-normal">PROOF</th></tr>
        </thead>
        <tbody>
          {projects.map((p) => {
            const link = p.slug ? `/work/${p.slug}` : p.href;
            return (
              <tr data-track={p.track} class="border-b border-[#161c18] transition-colors last:border-0 hover:bg-[#121714]">
                <td class="px-5 py-4 font-mono text-[13px] text-faint">{p.id}</td>
                <td class="px-5 py-4"><span class="block font-medium">{link ? <a href={link} class="hover:text-accent">{p.title}</a> : p.title}</span><span class="text-[13px] text-dim">{p.context}</span></td>
                <td class="px-5 py-4 text-muted">{p.track}</td>
                <td class="px-5 py-4 font-mono text-[13px] text-dim">{p.stack}</td>
                <td class="px-5 py-4"><span class={`inline-flex min-h-8 items-center rounded-lg border border-line-2 px-2.5 font-mono text-xs ${proofClass[p.proof]}`}>{p.proof}</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="font-mono text-xs text-faint">Live: public URL · Repo: code on GitHub (some private, shown on request) · Report: written deliverable · Brief: internship work, sanitized</p>
  </section>

  <!-- TOOLBOX -->
  <section id="toolbox" class="wrap flex scroll-mt-20 flex-col gap-8 pt-24">
    <div class="reveal flex flex-wrap items-end justify-between gap-5">
      <div class="flex flex-col gap-3.5">
        <span class="eyebrow">04 / TOOLBOX</span>
        <h2 class="font-display text-[clamp(30px,3.6vw,48px)] font-extrabold leading-none tracking-[-0.02em]">What I work with</h2>
      </div>
      <p class="max-w-[420px] text-base leading-relaxed text-muted">Solid: used in the projects above. Dashed: practiced in labs, school modules and mini-projects.</p>
    </div>
    <div class="grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3">
      {toolbox.map((g) => (
        <div class="reveal flex flex-col gap-4 rounded-2xl border border-line bg-panel p-6">
          <h3 class="font-display text-[22px] font-semibold">{g.name}</h3>
          <ul class="flex flex-wrap gap-2" aria-label={`${g.name} tools`}>
            {g.shipped.map((t) => <li class="rounded-md border border-[#2a3a18] bg-[#17200f] px-2.5 py-1.5 font-mono text-xs text-accent-2">{t}</li>)}
            {g.labs.map((t) => <li class="rounded-md border border-dashed border-[#2e3a33] px-2.5 py-1.5 font-mono text-xs text-muted"><span class="sr-only">Labs: </span>{t}</li>)}
          </ul>
        </div>
      ))}
      <div class="reveal flex flex-col gap-4 rounded-2xl border border-line bg-panel p-6">
        <h3 class="font-display text-[22px] font-semibold">Languages & certification</h3>
        <ul class="flex flex-col gap-2.5 text-[15px]">
          {person.languages.map((l) => <li class="flex justify-between border-b border-[#161c18] pb-2"><span class="text-fg-2">{l.name}</span><span class="font-mono text-xs text-dim">{l.level}</span></li>)}
          {person.certifications.map((c) => <li class="flex justify-between"><span class="text-accent-2">{c.name}</span><span class="font-mono text-xs text-dim">{c.date}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="wrap flex scroll-mt-20 flex-wrap gap-14 pt-28">
    <div class="reveal flex min-w-0 flex-[1_1_380px] flex-col gap-5">
      <span class="eyebrow">05 / ABOUT</span>
      <h2 class="h2">From the support desk to the security stack.</h2>
      <p class="text-[17px] leading-relaxed text-muted">I started in software QA, testing products before they reached users. Then two years on the front line at Concentrix, troubleshooting network security issues for Netgear customers at scale. Now a master's in cybersecurity, and an internship building an e-invoicing engine.</p>
      <p class="text-[17px] leading-relaxed text-muted">That path gave me something most juniors lack: I know how systems break in production, and how people actually use them. Trilingual, based in Lille, a short ride from Brussels. Open to France and Belgium.</p>
      <div class="flex aspect-[4/3] w-full max-w-[420px] items-center justify-center rounded-[18px] border border-dashed border-[#2a352f] bg-panel font-mono text-[13px] text-faint">[ photo coming soon ]</div>
    </div>
    <ol class="flex min-w-0 flex-[1.3_1_480px] flex-col" aria-label="Experience and education">
      {timeline.map((e) => (
        <li class="reveal grid grid-cols-[24px_1fr] gap-5">
          <div class="flex flex-col items-center">
            <span class={`mt-1 h-[13px] w-[13px] shrink-0 rounded-full ${e.active ? 'bg-accent shadow-[0_0_0_4px_#1c2a12]' : 'border-2 border-[#3a4a40] bg-ink'}`}></span>
            <span class="w-px flex-1 bg-[#1f2622]"></span>
          </div>
          <div class="flex flex-col gap-1.5 pb-9">
            <span class="font-mono text-xs text-dim">{e.when}</span>
            <span class="font-display text-2xl font-semibold">{e.org}</span>
            <span class="text-[15px] text-fg-2">{e.role}</span>
            <span class="text-[15px] leading-relaxed text-dim">{e.detail}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- SERVICES -->
  <section id="services" class="wrap flex scroll-mt-20 flex-col gap-10 pt-28">
    <div class="reveal flex flex-col gap-3.5">
      <span class="eyebrow">06 / FOR CLIENTS</span>
      <h2 class="h2">Need it secured, or built?</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="reveal spot card flex flex-col gap-4 p-8">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b8f25a" stroke-width="1.8" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
        <h3 class="font-display text-2xl font-semibold">Security audit</h3>
        <p class="text-[15px] leading-relaxed text-muted">Workstation, network or web app review against CIS and OWASP, with every finding backed by evidence and a prioritized fix plan.</p>
        <a href="/work/canritco-audit" class="mt-auto font-mono text-xs text-accent hover:underline">See an example audit →</a>
      </div>
      <div class="reveal spot card flex flex-col gap-4 p-8">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b8f25a" stroke-width="1.8" aria-hidden="true"><circle cx="6" cy="6" r="2.5"></circle><circle cx="18" cy="18" r="2.5"></circle><path d="M6 8.5V14a4 4 0 0 0 4 4h5.5"></path></svg>
        <h3 class="font-display text-2xl font-semibold">CI/CD and container hardening</h3>
        <p class="text-[15px] leading-relaxed text-muted">Image and dependency scanning, secret hygiene and Kubernetes admission policies, added to your pipeline without slowing the team down.</p>
        <a href="/work/supply-chain-security" class="mt-auto font-mono text-xs text-accent hover:underline">See the pipeline →</a>
      </div>
      <div class="reveal spot card flex flex-col gap-4 p-8">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b8f25a" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="m8 10 2 2-2 2M13 14h3"></path></svg>
        <h3 class="font-display text-2xl font-semibold">Websites and web apps</h3>
        <p class="text-[15px] leading-relaxed text-muted">Fast, secure-by-default sites and internal tools for small businesses: reservations, forms, admin area, all with proper validation and access control.</p>
        <a href="/work/ladress" class="mt-auto font-mono text-xs text-accent hover:underline">See a client site →</a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="wrap scroll-mt-20 pb-24 pt-28">
    <div class="reveal relative flex flex-wrap items-end justify-between gap-10 overflow-hidden rounded-[28px] border border-line-2 bg-[#0f1411] p-[clamp(28px,6vw,80px)]">
      <div class="absolute -right-32 -top-32 h-[420px] w-[420px] rounded-full border border-[#22302a]" aria-hidden="true"></div>
      <div class="absolute -right-10 -top-10 h-[260px] w-[260px] rounded-full border border-[#22302a]" aria-hidden="true"></div>
      <div class="relative flex min-w-0 flex-[999_1_480px] flex-col gap-4">
        <span class="eyebrow">07 / CONTACT</span>
        <h2 class="font-display text-[clamp(40px,6vw,84px)] font-extrabold leading-[.95] tracking-[-0.03em]">Let's open a ticket.</h2>
        <p class="max-w-[520px] text-lg leading-relaxed text-muted">Recruiting for a 6-month internship from March 2027, or need help on a project? I reply within 24 hours.</p>
      </div>
      <div class="relative flex min-w-0 flex-[1_1_300px] flex-col gap-3">
        <a href={`mailto:${person.email}`} class="flex min-h-14 items-center justify-between gap-3 rounded-xl bg-accent px-5 font-semibold text-ink [overflow-wrap:anywhere] hover:bg-accent-2">{person.email}<Fragment set:html={ext} /></a>
        <button type="button" data-copy-email class="flex min-h-14 cursor-pointer items-center justify-between rounded-xl border border-[#2e3a33] px-5 text-fg hover:border-[#4a5a50]"><span data-copy-label>Copy email</span><span class="font-mono text-xs text-faint">clipboard</span></button>
        <a href={person.linkedin} class="flex min-h-14 items-center justify-between rounded-xl border border-[#2e3a33] px-5 text-fg hover:border-[#4a5a50]">LinkedIn / sekkouri<Fragment set:html={ext} /></a>
        <a href={person.github} class="flex min-h-14 items-center justify-between rounded-xl border border-[#2e3a33] px-5 text-fg hover:border-[#4a5a50]">GitHub / MouaadSek<Fragment set:html={ext} /></a>
      </div>
    </div>
  </section>
</Base>
