---
import Base from '../layouts/Base.astro';
import { content, path, cvPdf, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { person, projects } = content(lang);
const site = 'mouaadsek.vercel.app';
const others = projects.filter((p) => !p.slug).length;

const copy = {
  en: {
    title: 'CV · Mouaad Sekkouri', desc: 'CV of Mouaad Sekkouri, M2 Cybersecurity, Cloud Security and DevSecOps.',
    back: '← back to portfolio', download: 'Download PDF',
    headline: 'Cloud Security & DevSecOps · M2 Cybersecurity',
    seeking: 'Available now for an alternance, or a 6-month internship from March 2027 · Mobile across France',
    h: { profile: 'Profile', exp: 'Experience', proj: 'Selected projects', projNote: `case studies on ${site}`, skills: 'Skills', edu: 'Education', cert: 'Certification', lang: 'Languages' },
    profile: 'Cybersecurity master’s student with four years in IT (QA, then network security support) and a rare mix: I audit and harden systems, and I also ship real products, one of them live in production. I care about security that teams can actually live with: gates in CI, policies in the cluster, evidence behind every finding.',
    experience: [
      { role: 'Internship, e-invoicing platform', org: 'Baïfall Dream', place: 'Paris', when: 'Jul 2026 - Sep 2026', bullets: [
        'Wrote the specification of a B2B e-invoicing platform for the 2026 French reform: benchmark of 3 platforms, 95 requirements.',
        'Built the Factur-X / UBL engine and data model in Python, FastAPI and PostgreSQL, covered by 950+ automated tests.',
        'Security by design: multi-tenant isolation with PostgreSQL RLS, Argon2id, revocable server sessions, CSRF, deny-by-default roles.',
        'Compliance validated by an external body (FNFE): 0 errors on all 3 control levels, after reducing 7 anomalies to 0.',
      ] },
      { role: 'IT support technician (Netgear)', org: 'Concentrix', place: 'Warsaw, remote', when: 'Jan 2024 - Dec 2025', bullets: [
        'Triaged and resolved 1,500+ network and security incidents, 85% first contact resolution, L2/L3 escalation under SLA.',
        'Log analysis and detection of security misconfigurations; wrote 40+ procedures, cut average resolution time by 20%.',
      ] },
      { role: 'Software QA tester', org: 'Lionbridge', place: 'Warsaw', when: 'May 2023 - Jan 2024', bullets: ['Validated 200,000+ localized strings with an error rate under 0.5% over 8 consecutive months.'] },
      { role: 'Software QA tester', org: 'Testronic', place: 'Warsaw', when: 'Jan 2022 - May 2023', bullets: ['Ran 1,500+ web and mobile test cases in Agile teams, caught 90+ critical defects before production (Jira).'] },
    ],
    selected: [
      { name: 'Travistello', tag: 'live product', text: 'Travel gear research platform in production: Next.js 16, Payload CMS, Postgres. Opaque redirects, privacy-minimal analytics, evidence-backed scores.' },
      { name: 'Supply chain security on Kubernetes', tag: 'DevSecOps', text: 'GitLab CI blocks critical CVEs (Trivy, Safety); OPA Gatekeeper denies unapproved registries, latest tags and root pods.' },
      { name: 'JobPilot', tag: 'automation', text: 'Job search engine in Python: 8 source connectors, cross-source deduplication, scoring, tailored CVs. 2,100+ tests.' },
      { name: 'Canritco infrastructure audit', tag: 'audit, team of 2', text: 'CIA asset inventory, Nmap exposure, 621 CIS checks (HardeningKitty), Hayabusa logs, top 10 risks, 90-day plan.' },
      { name: 'NetSecure Corp network audit', tag: 'network', text: 'PCAP forensics, 8-step attack chain mapped to MITRE ATT&CK, 12 findings; redesign with 5 VLANs, 802.1X, nftables, Suricata.' },
      { name: "L'Adress restaurant website", tag: 'real business', text: 'Next.js 15 and Supabase: reservations and quotes with Zod validation, rate limiting, 16 RLS policies, CSP.' },
    ],
    more: 'more: DevSecOps Flask delivery (Kaniko, K8s), Fleetman on Kubernetes, Terraform and Ansible on Azure, monitoring stack, AD hardening, private CA messaging, Interview Assist (Electron).',
    skills: [
      { k: 'Cloud & containers', v: 'Kubernetes, Docker, Azure, Terraform, Ansible, kind' },
      { k: 'DevSecOps', v: 'GitLab CI, Trivy, Safety, OPA Gatekeeper (Rego), Kaniko, SonarQube' },
      { k: 'Security & audit', v: 'Nmap, HardeningKitty, Hayabusa, Wireshark, Suricata, BloodHound, nftables, 802.1X' },
      { k: 'GRC', v: 'Risk register, CIA inventory, MITRE ATT&CK; coursework in EBIOS RM, ISO 27001, NIS2' },
      { k: 'Development', v: 'Python, FastAPI, TypeScript, Next.js, React, PostgreSQL, Playwright, Electron' },
      { k: 'Labs & coursework', v: 'Azure Sentinel, KQL, Entra ID, Wazuh, Sigma, Burp Suite, Metasploit, PingCastle, Proxmox, pfSense, GNS3, Zabbix' },
    ],
    edu: [
      { d: 'M2 Cybersecurity, PGE', s: 'SUPINFO, Lille', w: '2025 - 2027 · M1 done 2026' },
      { d: 'Bachelor, Computer Engineering', s: 'Vistula University, Warsaw', w: '2021 - 2024' },
    ],
    certDate: 'Microsoft · March 2026',
    portfolio: 'Full portfolio, 47 projects on a lab map and 6 case studies:',
  },
  fr: {
    title: 'CV · Mouaad Sekkouri', desc: 'CV de Mouaad Sekkouri, M2 Cybersécurité, sécurité cloud et DevSecOps.',
    back: '← retour au portfolio', download: 'Télécharger le PDF',
    headline: 'Sécurité Cloud & DevSecOps · M2 Cybersécurité',
    seeking: 'Disponible en alternance dès maintenant, ou en stage de 6 mois dès mars 2027 · Mobile partout en France',
    h: { profile: 'Profil', exp: 'Expérience', proj: 'Projets choisis', projNote: `études de cas sur ${site}`, skills: 'Compétences', edu: 'Formation', cert: 'Certification', lang: 'Langues' },
    profile: 'Étudiant en master cybersécurité avec quatre ans d’expérience IT (QA, puis support réseau et sécurité) et un profil rare : j’audite et je durcis des systèmes, et je livre aussi de vrais produits, dont un en production. Je défends une sécurité avec laquelle les équipes peuvent vivre : des contrôles dans la CI, des politiques dans le cluster, une preuve derrière chaque constat.',
    experience: [
      { role: 'Stage, plateforme d’e-facturation', org: 'Baïfall Dream', place: 'Paris', when: 'Juil. 2026 - Sept. 2026', bullets: [
        'Cahier des charges d’une plateforme d’e-facturation (réforme B2B 2026) : benchmark de 3 plateformes, 95 exigences.',
        'Développement du moteur Factur-X / UBL et du modèle de données en Python, FastAPI et PostgreSQL, 950+ tests automatisés.',
        'Sécurité by design : isolation multi-tenant par RLS PostgreSQL, Argon2id, sessions révocables, CSRF, rôles fermés par défaut.',
        'Conformité validée par un organisme externe (FNFE) : 0 erreur sur les 3 niveaux de contrôle, 7 anomalies ramenées à 0.',
      ] },
      { role: 'Technicien support informatique (Netgear)', org: 'Concentrix', place: 'Varsovie, à distance', when: 'Janv. 2024 - Déc. 2025', bullets: [
        'Triage et résolution de 1 500+ incidents réseau et sécurité, 85 % de résolution au premier contact, escalade L2/L3 selon SLA.',
        'Analyse de logs et détection de mauvaises configurations ; 40+ procédures rédigées, délai moyen de résolution réduit de 20 %.',
      ] },
      { role: 'Testeur logiciel QA', org: 'Lionbridge', place: 'Varsovie', when: 'Mai 2023 - Janv. 2024', bullets: ['Validation de 200 000+ chaînes localisées, taux d’erreur inférieur à 0,5 % sur 8 mois consécutifs.'] },
      { role: 'Testeur logiciel QA', org: 'Testronic', place: 'Varsovie', when: 'Janv. 2022 - Mai 2023', bullets: ['1 500+ cas de test web et mobile en environnement Agile, 90+ anomalies critiques détectées avant production (Jira).'] },
    ],
    selected: [
      { name: 'Travistello', tag: 'en production', text: 'Plateforme de recherche sur l’équipement de voyage : Next.js 16, Payload CMS, Postgres. Redirections opaques, analytics minimalistes, notes sourcées.' },
      { name: 'Sécurité de la supply chain sur Kubernetes', tag: 'DevSecOps', text: 'GitLab CI bloque les CVE critiques (Trivy, Safety) ; OPA Gatekeeper refuse registres non approuvés, tag latest et pods root.' },
      { name: 'JobPilot', tag: 'automatisation', text: 'Moteur de recherche d’emploi en Python : 8 connecteurs, dédoublonnage inter-sources, scoring, CV adaptés. 2 100+ tests.' },
      { name: 'Audit d’infrastructure Canritco', tag: 'audit, binôme', text: 'Inventaire DIC, exposition Nmap, 621 contrôles CIS (HardeningKitty), logs Hayabusa, top 10 des risques, plan à 90 jours.' },
      { name: 'Audit réseau NetSecure Corp', tag: 'réseau', text: 'Forensique PCAP, chaîne d’attaque en 8 étapes (MITRE ATT&CK), 12 constats ; refonte en 5 VLAN, 802.1X, nftables, Suricata.' },
      { name: "Site du restaurant L'Adress", tag: 'commerce réel', text: 'Next.js 15 et Supabase : réservations et devis avec validation Zod, limitation de débit, 16 politiques RLS, CSP.' },
    ],
    more: 'autres : livraison DevSecOps Flask (Kaniko, K8s), Fleetman sur Kubernetes, Terraform et Ansible sur Azure, stack de monitoring, durcissement AD, messagerie avec PKI privée, Interview Assist (Electron).',
    skills: [
      { k: 'Cloud & conteneurs', v: 'Kubernetes, Docker, Azure, Terraform, Ansible, kind' },
      { k: 'DevSecOps', v: 'GitLab CI, Trivy, Safety, OPA Gatekeeper (Rego), Kaniko, SonarQube' },
      { k: 'Sécurité & audit', v: 'Nmap, HardeningKitty, Hayabusa, Wireshark, Suricata, BloodHound, nftables, 802.1X' },
      { k: 'GRC', v: 'Registre des risques, inventaire DIC, MITRE ATT&CK ; cours : EBIOS RM, ISO 27001, NIS2' },
      { k: 'Développement', v: 'Python, FastAPI, TypeScript, Next.js, React, PostgreSQL, Playwright, Electron' },
      { k: 'Labs et cours', v: 'Azure Sentinel, KQL, Entra ID, Wazuh, Sigma, Burp Suite, Metasploit, PingCastle, Proxmox, pfSense, GNS3, Zabbix' },
    ],
    edu: [
      { d: 'M2 Cybersécurité, PGE', s: 'SUPINFO, Lille', w: '2025 - 2027 · M1 validé en 2026' },
      { d: 'Bachelor Génie Informatique', s: 'Vistula University, Varsovie', w: '2021 - 2024' },
    ],
    certDate: 'Microsoft · Mars 2026',
    portfolio: 'Portfolio complet, 47 projets cartographiés et 6 études de cas :',
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.desc} bare>
  <div class="cv-screen flex flex-col items-center gap-5 bg-[#1a1d1b] px-4 py-8 print:bg-white print:p-0">
    <div class="no-print flex w-full max-w-[210mm] flex-wrap items-center justify-between gap-3">
      <a href={path(lang, '/')} class="font-mono text-sm text-fg-2 hover:text-accent">{copy.back}</a>
      <span class="flex items-center gap-3">
        <a href={lang === 'fr' ? '/en/cv' : '/cv'} class="font-mono text-sm text-fg-2 hover:text-accent">{lang === 'fr' ? 'EN' : 'FR'}</a>
        <a href={cvPdf(lang)} download class="btn-primary min-h-11 px-4 text-sm">{copy.download}</a>
      </span>
    </div>

    <article class="cv-page flex h-[297mm] w-[210mm] max-w-full flex-col overflow-hidden bg-white text-[#16191a] shadow-2xl print:shadow-none">
      <header class="flex items-end justify-between gap-6 bg-[#0a0c0b] px-[14mm] pb-[7mm] pt-[9mm] text-[#e8ede9]">
        <div class="flex flex-col gap-1">
          <h1 class="font-display text-[30px] font-extrabold leading-none tracking-[-0.02em]">Mouaad Sekkouri</h1>
          <p class="font-display text-[14px] font-semibold text-[#b8f25a]">{copy.headline}</p>
          <p class="mt-1 text-[10px] text-[#a9b5ae]">{copy.seeking}</p>
        </div>
        <ul class="flex shrink-0 flex-col items-end gap-0.5 font-mono text-[9px] text-[#c4cec8]">
          <li>{lang === 'fr' ? 'Lille, mobile France' : 'Lille, mobile in France'}</li>
          <li>{person.email}</li>
          <li>{site}</li>
          <li>linkedin.com/in/sekkouri</li>
          <li>github.com/MouaadSek</li>
        </ul>
      </header>

      <div class="grid flex-1 grid-cols-[1fr_62mm] gap-[7mm] px-[14mm] py-[7mm]">
        <div class="flex min-w-0 flex-col gap-[5mm]">
          <section>
            <h2 class="cv-h">{copy.h.profile}</h2>
            <p class="text-[10px] leading-[1.5] text-[#2b3130]">{copy.profile}</p>
          </section>

          <section>
            <h2 class="cv-h">{copy.h.exp}</h2>
            <div class="flex flex-col gap-[2.6mm]">
              {copy.experience.map((e) => (
                <div>
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="text-[11px] font-semibold">{e.role} · <span class="text-[#3d6b0f]">{e.org}</span></span>
                    <span class="shrink-0 font-mono text-[8.5px] text-[#5c6863]">{e.when}</span>
                  </div>
                  <span class="block text-[9px] text-[#5c6863]">{e.place}</span>
                  <ul class="mt-1 flex list-none flex-col gap-0.5">
                    {e.bullets.map((b) => <li class="relative pl-3 text-[9.5px] leading-[1.42] text-[#2b3130] before:absolute before:left-0 before:top-[5px] before:h-[3px] before:w-[3px] before:rounded-full before:bg-[#7cb518]">{b}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>

          <section>
            <h2 class="cv-h">{copy.h.proj} <span class="font-mono text-[8.5px] font-normal normal-case tracking-normal text-[#5c6863]">{copy.h.projNote}</span></h2>
            <div class="flex flex-col gap-[1.4mm]">
              {copy.selected.map((p) => (
                <div>
                  <span class="text-[10px] font-semibold">{p.name}</span> <span class="font-mono text-[8px] uppercase text-[#5c6863]">{p.tag}</span>
                  <p class="text-[9.5px] leading-[1.42] text-[#2b3130]">{p.text}</p>
                </div>
              ))}
              <p class="font-mono text-[8.5px] text-[#5c6863]">+ {others} {copy.more}</p>
            </div>
          </section>
        </div>

        <aside class="flex min-w-0 flex-col gap-[5mm] border-l border-[#e3e8e5] pl-[6mm]">
          <section>
            <h2 class="cv-h">{copy.h.skills}</h2>
            <dl class="flex flex-col gap-[2.2mm]">
              {copy.skills.map((s) => (<div><dt class="text-[9.5px] font-semibold">{s.k}</dt><dd class="text-[9px] leading-[1.42] text-[#2b3130]">{s.v}</dd></div>))}
            </dl>
          </section>
          <section>
            <h2 class="cv-h">{copy.h.edu}</h2>
            <div class="flex flex-col gap-[2.2mm] text-[9.5px]">
              {copy.edu.map((e) => <div><span class="block font-semibold">{e.d}</span><span class="block text-[#2b3130]">{e.s}</span><span class="font-mono text-[8.5px] text-[#5c6863]">{e.w}</span></div>)}
            </div>
          </section>
          <section>
            <h2 class="cv-h">{copy.h.cert}</h2>
            <p class="text-[9.5px]"><span class="font-semibold">AZ-900</span> Azure Fundamentals<br /><span class="font-mono text-[8.5px] text-[#5c6863]">{copy.certDate}</span></p>
          </section>
          <section>
            <h2 class="cv-h">{copy.h.lang}</h2>
            <ul class="flex flex-col gap-1 text-[9.5px]">
              {person.languages.map((l) => <li class="flex justify-between gap-2"><span>{l.name}</span><span class="text-right font-mono text-[8.5px] text-[#5c6863]">{l.level}</span></li>)}
            </ul>
          </section>
          <section class="mt-auto rounded-md bg-[#f2f6ee] p-[3mm]">
            <p class="font-mono text-[8.5px] leading-[1.45] text-[#3d6b0f]">{copy.portfolio}<br /><span class="font-semibold">{site}{lang === 'en' ? '/en' : ''}</span></p>
          </section>
        </aside>
      </div>
    </article>
  </div>
</Base>
