---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { ui, path, content, cvPdf, type Lang } from '../i18n';
import { projectTools } from '../data/graph';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const { person, projects, tracks, toolbox, timeline, stats, cases, trackLabel } = content(lang);
const nf = lang === 'fr' ? 'fr-FR' : 'en-US';
const trackColors: Record<string, string> = { Products: '#b8f25a', DevSecOps: '#5eead4', 'Cloud & SRE': '#f5a524', 'Security audit': '#ff8a5c' };
const toolCount = new Map<string, number>();
Object.values(projectTools).flat().forEach((tool) => toolCount.set(tool, (toolCount.get(tool) ?? 0) + 1));
const graphTools = [...toolCount.entries()].sort((a, b) => b[1] - a[1]);
const graphData = JSON.stringify({
  tools: graphTools.map(([tool]) => tool),
  projects: projects.map((p) => ({ id: p.id, title: p.title, track: p.track, href: p.slug ? path(lang, `/work/${p.slug}`) : p.href, tools: projectTools[p.id] ?? [] })),
  colors: trackColors,
});
const termData = JSON.stringify({
  lang,
  email: person.email,
  cv: path(lang, '/cv'),
  pdf: cvPdf(lang),
  alt: lang === 'fr' ? '/' : '/fr/',
  home: path(lang, '/'),
  cases: cases.map((c) => ({ id: c.id.toLowerCase(), slug: c.slug, title: c.title, track: c.track, href: path(lang, `/work/${c.slug}`) })),
  skills: toolbox.map((g) => ({ name: g.name, tools: g.shipped.slice(0, 6) })),
  t: t.terminal,
});

const spans = ['lg:col-span-4', 'lg:col-span-2', 'lg:col-span-2', 'lg:col-span-4', 'lg:col-span-3', 'lg:col-span-3'];
const filters = ['All', ...tracks.map((x) => x.key)];
const proofClass: Record<string, string> = { Live: 'text-amber', Repo: 'text-accent', Report: 'text-fg-2', Brief: 'text-fg-2' };
const arrow = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
const ext = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"></path></svg>';
const serviceIcons = [
  '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"></path><path d="m9 12 2 2 4-4"></path>',
  '<circle cx="6" cy="6" r="2.5"></circle><circle cx="18" cy="18" r="2.5"></circle><path d="M6 8.5V14a4 4 0 0 0 4 4h5.5"></path>',
  '<rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="m8 10 2 2-2 2M13 14h3"></path>',
];
---
<Base lang={lang}>
  <Fragment set:html="<!-- Curious? Good. CTF 1/5: MSK{v13w_s0urc3_1s_4_sk1ll} . Submit it in the terminal: submit MSK{...} -->" />
  <!-- HERO -->
  <section class="relative overflow-hidden" id="top">
    <div class="grid-bg pointer-events-none absolute inset-0 h-[900px]" aria-hidden="true"></div>
    <canvas data-packets class="pointer-events-none absolute inset-0 h-full w-full opacity-80 [mask-image:linear-gradient(to_right,rgba(0,0,0,.18)_0%,rgba(0,0,0,.35)_38%,#000_58%)]" aria-hidden="true"></canvas>
    <div class="wrap relative flex flex-wrap items-center gap-14 pb-24 pt-16 sm:pt-20">
      <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-7">
        <p class="inline-flex items-center gap-2.5 self-start rounded-full border border-line-2 bg-[#0f1411] px-3.5 py-2 font-mono text-[13px] text-fg-2">
          <span class="pulse-dot h-2 w-2 shrink-0 rounded-full bg-accent"></span>{person.availability}
        </p>
        <h1 class={`font-display font-extrabold leading-[.95] tracking-[-0.03em] ${lang === 'fr' ? 'text-[clamp(44px,6.2vw,92px)]' : 'text-[clamp(48px,7vw,104px)]'}`}>
          {t.heroTitleA}<br />{t.heroTitleB1}<span class="text-accent">{t.heroTitleShip}</span>{t.heroTitleB2}
        </h1>
        <p class="max-w-[640px] text-xl leading-relaxed text-muted">{t.heroLead}</p>
        <div class="flex flex-wrap gap-3.5">
          <a href="#contact" class="btn-primary">{t.hire} <Fragment set:html={arrow} /></a>
          <a href="#services" class="btn-ghost">{t.workWith}</a>
          <a href={cvPdf(lang)} class="btn px-3 font-normal text-muted hover:text-fg" download>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>{t.cvPdf}
          </a>
        </div>
        <p class="hidden items-center gap-2.5 font-mono text-xs text-dim sm:flex" aria-hidden="true">
          <span class="rounded-md border border-[#3a2216] bg-[#1d110c] px-2 py-1 text-[#ff8a5c]"><span data-blocked>0</span></span>
          {t.packets}
        </p>
      </div>

      <div data-terminal={termData} class="min-w-0 flex-[1_1_400px] cursor-text overflow-hidden rounded-[18px] border border-[#1f2622] bg-[#0e1210] shadow-[0_40px_80px_-30px_rgba(0,0,0,.8)]">
        <div class="flex items-center gap-2 border-b border-[#1a201c] px-4 py-3.5">
          <span class="h-[11px] w-[11px] rounded-full bg-[#2a332e]"></span><span class="h-[11px] w-[11px] rounded-full bg-[#2a332e]"></span><span class="h-[11px] w-[11px] rounded-full bg-[#2a332e]"></span>
          <span class="ml-2.5 font-mono text-xs text-faint">soc-console / whoami</span>
          <span class="ml-auto hidden font-mono text-[11px] text-faint sm:inline">{t.terminal.hint}</span>
        </div>
        <div class="px-5 pb-6 pt-5 font-mono text-[14px] leading-[1.85] text-fg-2">
          <div><span class="text-accent">$</span> <span data-type="whoami --verbose">whoami --verbose</span></div>
          <dl class="grid grid-cols-[88px_1fr]">
            <dt class="text-faint">name</dt><dd>{person.name}</dd>
            <dt class="text-faint">role</dt><dd>{person.role}</dd>
            <dt class="text-faint">base</dt><dd>{t.term.base}</dd>
            <dt class="text-faint">langs</dt><dd>FR, EN (C1), AR, DE (A2)</dd>
            <dt class="text-faint">stack</dt><dd>K8s, Azure, GitLab CI, Next.js</dd>
            <dt class="text-faint">certs</dt><dd>AZ-900</dd>
          </dl>
          <div class="mt-2.5"><span class="text-accent">$</span> status</div>
          <div><span class="text-amber">[LIVE]</span> {t.term.live}</div>
          <div><span class="text-dim">[DONE]</span> {t.term.done}</div>
          <div><span class="text-accent">[OPEN]</span> {t.term.open}</div>
          <div><span class="text-accent">[OPEN]</span> {t.term.open2}</div>
          <div data-term-out aria-live="polite" class="max-h-[260px] overflow-y-auto"></div>
          <form data-term-form class="mt-2.5 flex items-center gap-2" autocomplete="off">
            <label for="term-input" class="text-accent">$<span class="sr-only">{t.terminal.label}</span></label>
            <input id="term-input" data-term-input type="text" spellcheck="false" autocapitalize="off" placeholder={t.terminal.placeholder} class="min-w-0 flex-1 bg-transparent text-base text-fg caret-accent sm:text-[14px] placeholder:text-faint focus:outline-none" />
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section aria-label={t.statsLabel} class="border-y border-[#1a201c] bg-panel-2">
    <div class="wrap grid grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class={`flex flex-col gap-1.5 py-9 ${i % 2 ? 'border-l border-[#1a201c] pl-6' : 'pr-6'} ${i === 2 ? 'lg:border-l lg:pl-6' : ''} ${i > 1 ? 'border-t border-[#1a201c] lg:border-t-0' : ''}`}>
          <span class="font-display text-[clamp(36px,4vw,48px)] font-extrabold"><span data-count={s.value} data-locale={nf}>{s.value.toLocaleString(nf)}</span><span class="text-accent">{s.suffix}</span></span>
          <span class="text-[15px] text-dim">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- TRACKS -->
  <section class="wrap flex flex-col gap-10 pt-28">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="flex flex-col gap-3.5">
        <span class="eyebrow">{t.s1}</span>
        <h2 class="h2">{t.s1Title}</h2>
      </div>
      <p class="max-w-[440px] text-[17px] leading-relaxed text-muted">{t.s1Lead}</p>
    </div>
    <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
      {tracks.map((tr) => {
        const count = projects.filter((p) => p.track === tr.key).length;
        return (
          <div class="reveal spot card flex flex-col gap-4 p-6">
            <div class="flex items-center justify-between font-mono text-xs"><span class="text-faint">{tr.code}</span><span class="text-muted">{count} {t.projectsWord}</span></div>
            <span class="font-display text-2xl font-semibold">{tr.name}</span>
            <span class="text-[15px] leading-relaxed text-muted">{tr.desc}</span>
            <div class="mt-auto h-1.5 overflow-hidden rounded-full bg-[#1a201c]"><div class={`h-full rounded-full bg-accent ${tr.bar}`}></div></div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- FEATURED -->
  <section id="work" class="wrap flex scroll-mt-20 flex-col gap-10 pt-28">
    <div class="reveal flex flex-col gap-3.5">
      <span class="eyebrow">{t.s2}</span>
      <h2 class="h2 max-w-[900px]">{t.s2Title}</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-6">
      {cases.map((c, i) => (
        <a href={path(lang, `/work/${c.slug}`)} class={`reveal spot card group flex flex-col text-fg ${spans[i]}`}>
          <div class="relative h-64 border-b border-line">
            <Art type={c.art} />
            <span class="absolute left-4 top-4 rounded-md border border-line-2 bg-[#151b17] px-2.5 py-1 font-mono text-xs text-accent">{c.id}</span>
            {c.live && <span class="absolute right-4 top-4 flex items-center gap-2 rounded-md border border-[#3a2c10] bg-[#1e1708] px-2.5 py-1 font-mono text-xs text-amber"><span class="h-[7px] w-[7px] rounded-full bg-amber"></span>{t.live}</span>}
          </div>
          <div class="flex flex-1 flex-col gap-3 p-6">
            <span class="font-mono text-xs text-dim">{c.track}</span>
            <h3 class="font-display text-[26px] font-semibold leading-tight">{c.title}</h3>
            <p class="text-[15px] leading-relaxed text-muted">{c.summary}</p>
            <div class="mt-1 flex flex-wrap gap-2">{c.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
            <span class="mt-auto flex items-center gap-2 pt-3 text-[15px] font-medium text-accent">{t.readCase} <span class="transition-transform group-hover:translate-x-1"><Fragment set:html={arrow} /></span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- INDEX -->
  <section id="index" class="wrap flex scroll-mt-20 flex-col gap-7 pt-24">
    <div class="reveal flex flex-wrap items-end justify-between gap-5">
      <div class="flex flex-col gap-3.5">
        <span class="eyebrow">{t.s3}</span>
        <h2 class="font-display text-[clamp(30px,3.6vw,48px)] font-extrabold leading-none tracking-[-0.02em]">{t.s3Title}</h2>
      </div>
      <span class="font-mono text-[13px] text-dim">{t.showing} <span data-shown>{projects.length}</span> / {projects.length}</span>
    </div>
    <div role="group" aria-label={t.filterLabel} class="flex flex-wrap gap-2.5">
      {filters.map((f, i) => (
        <button type="button" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'} class="min-h-11 cursor-pointer rounded-full border border-line-2 bg-panel px-4 text-sm font-medium text-fg-2 transition-colors hover:border-[#3a4a40] aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-ink">{trackLabel[f]}</button>
      ))}
    </div>
    <div class="overflow-x-auto rounded-2xl border border-line">
      <table class="w-full min-w-[780px] border-collapse text-left text-[15px]">
        <caption class="sr-only">{t.tableCaption}</caption>
        <thead class="bg-panel-2 font-mono text-xs text-faint">
          <tr class="border-b border-line">
            <th scope="col" class="w-[80px] px-5 py-3.5 font-normal">{t.th[0]}</th><th scope="col" class="px-5 py-3.5 font-normal">{t.th[1]}</th><th scope="col" class="px-5 py-3.5 font-normal">{t.th[2]}</th><th scope="col" class="px-5 py-3.5 font-normal">{t.th[3]}</th><th scope="col" class="w-[110px] px-5 py-3.5 font-normal">{t.th[4]}</th>
          </tr>
        </thead>
        <tbody>
          {projects.map((p) => {
            const link = p.slug ? path(lang, `/work/${p.slug}`) : p.href;
            return (
              <tr data-track={p.track} class="border-b border-[#161c18] transition-colors last:border-0 hover:bg-[#121714]">
                <td class="px-5 py-4 font-mono text-[13px] text-faint">{p.id}</td>
                <td class="px-5 py-4"><span class="block font-medium">{link ? <a href={link} class="hover:text-accent">{p.title}</a> : p.title}</span><span class="text-[13px] text-dim">{p.context}</span></td>
                <td class="px-5 py-4 text-muted">{trackLabel[p.track]}</td>
                <td class="px-5 py-4 font-mono text-[13px] text-dim">{p.stack}</td>
                <td class="px-5 py-4"><span class={`inline-flex min-h-8 items-center rounded-lg border border-line-2 px-2.5 font-mono text-xs ${proofClass[p.proof]}`}>{t.proof[p.proof]}</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="font-mono text-xs text-faint">{t.proofLegend}</p>
  </section>

  <!-- TOOLBOX -->
  <section id="toolbox" class="wrap flex scroll-mt-20 flex-col gap-8 pt-24">
    <div class="reveal flex flex-wrap items-end justify-between gap-5">
      <div class="flex flex-col gap-3.5">
        <span class="eyebrow">{t.s4}</span>
        <h2 class="font-display text-[clamp(30px,3.6vw,48px)] font-extrabold leading-none tracking-[-0.02em]">{t.s4Title}</h2>
      </div>
      <p class="max-w-[420px] text-base leading-relaxed text-muted">{t.s4Lead}</p>
    </div>
    <div data-graph={graphData} class="reveal flex flex-col gap-4 rounded-2xl border border-line bg-[#0b0e0c] p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-display text-xl font-semibold">{t.graph.title}</h3>
        <span class="font-mono text-xs text-faint">{t.graph.hint}</span>
      </div>
      <canvas class="block h-[520px] w-full" role="img" aria-label={t.graph.aria}></canvas>
      <div data-g-panel hidden class="rounded-xl border border-line-2 bg-panel p-4">
        <span class="font-mono text-[11px] text-faint">{t.graph.usedIn}</span>
        <p data-g-title class="font-display text-lg font-semibold text-accent"></p>
        <ul data-g-list class="mt-2 flex flex-wrap gap-x-5 gap-y-1.5 text-[14px]"></ul>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-dim">
        {Object.entries(trackColors).map(([k, col]) => <span class="flex items-center gap-2"><span class={`h-2.5 w-2.5 ${k === 'Products' ? 'bg-accent' : k === 'DevSecOps' ? 'bg-[#5eead4]' : k === 'Cloud & SRE' ? 'bg-amber' : 'bg-[#ff8a5c]'}`}></span>{trackLabel[k]}</span>)}
        <span class="flex items-center gap-2"><span class="h-3 w-3 rounded-full border-[1.5px] border-accent"></span>{t.graph.toolLegend}</span>
      </div>
      <div role="group" aria-label={t.graph.chipsLabel} class="flex flex-wrap gap-2">
        {graphTools.map(([tool, n]) => <button type="button" data-g-tool={tool} aria-pressed="false" class="min-h-9 cursor-pointer rounded-md border border-line-2 px-2.5 font-mono text-[11px] text-fg-2 hover:border-accent aria-pressed:border-accent aria-pressed:bg-[#17200f] aria-pressed:text-accent">{tool} <span class="text-faint">{n}</span></button>)}
      </div>
    </div>
    <div class="grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3">
      {toolbox.map((g) => (
        <div class="reveal flex flex-col gap-4 rounded-2xl border border-line bg-panel p-6">
          <h3 class="font-display text-[22px] font-semibold">{g.name}</h3>
          <ul class="flex flex-wrap gap-2" aria-label={`${g.name}, ${t.toolsSr}`}>
            {g.shipped.map((x) => <li class="rounded-md border border-[#2a3a18] bg-[#17200f] px-2.5 py-1.5 font-mono text-xs text-accent-2">{x}</li>)}
            {g.labs.map((x) => <li class="rounded-md border border-dashed border-[#2e3a33] px-2.5 py-1.5 font-mono text-xs text-muted"><span class="sr-only">{t.labsSr}</span>{x}</li>)}
          </ul>
        </div>
      ))}
      <div class="reveal flex flex-col gap-4 rounded-2xl border border-line bg-panel p-6">
        <h3 class="font-display text-[22px] font-semibold">{t.langCert}</h3>
        <ul class="flex flex-col gap-2.5 text-[15px]">
          {person.languages.map((l) => <li class="flex justify-between gap-3 border-b border-[#161c18] pb-2"><span class="text-fg-2">{l.name}</span><span class="font-mono text-xs text-dim">{l.level}</span></li>)}
          {person.certifications.map((c) => <li class="flex justify-between gap-3"><span class="text-accent-2">{c.name}</span><span class="shrink-0 font-mono text-xs text-dim">{c.date}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="wrap flex scroll-mt-20 flex-wrap gap-14 pt-28">
    <div class="reveal flex min-w-0 flex-[1_1_380px] flex-col gap-5">
      <span class="eyebrow">{t.s5}</span>
      <h2 class="h2">{t.s5Title}</h2>
      <p class="text-[17px] leading-relaxed text-muted">{t.about1}</p>
      <p class="text-[17px] leading-relaxed text-muted">{t.about2}</p>
      <a href={path(lang, '/security')} class="spot card group mt-2 flex max-w-[460px] flex-col gap-3 p-6 text-fg">
        <span class="flex items-center gap-2 font-mono text-xs text-accent"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"></path></svg>{t.securityCard.tag}</span>
        <span class="font-display text-2xl font-semibold">{t.securityCard.title}</span>
        <span class="text-[15px] leading-relaxed text-muted">{t.securityCard.text}</span>
        <span class="font-mono text-xs text-accent transition-transform group-hover:translate-x-1">{t.securityCard.cta}</span>
      </a>
    </div>
    <ol class="flex min-w-0 flex-[1.3_1_480px] flex-col" aria-label={t.timelineLabel}>
      {timeline.map((e) => (
        <li class="reveal grid grid-cols-[24px_1fr] gap-5">
          <div class="flex flex-col items-center">
            <span class={`mt-1 h-[13px] w-[13px] shrink-0 rounded-full ${e.active ? 'bg-accent shadow-[0_0_0_4px_#1c2a12]' : 'border-2 border-[#3a4a40] bg-ink'}`}></span>
            <span class="w-px flex-1 bg-[#1f2622]"></span>
          </div>
          <div class="flex flex-col gap-1.5 pb-9">
            <span class="font-mono text-xs text-dim">{e.when}</span>
            <span class="font-display text-2xl font-semibold">{e.org}</span>
            <span class="text-[15px] text-fg-2">{e.role}</span>
            <span class="text-[15px] leading-relaxed text-dim">{e.detail}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- SERVICES -->
  <section id="services" class="wrap flex scroll-mt-20 flex-col gap-10 pt-28">
    <div class="reveal flex flex-col gap-3.5">
      <span class="eyebrow">{t.s6}</span>
      <h2 class="h2">{t.s6Title}</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {t.services.map((s, i) => (
        <div class="reveal spot card flex flex-col gap-4 p-8">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b8f25a" stroke-width="1.8" aria-hidden="true" set:html={serviceIcons[i]}></svg>
          <h3 class="font-display text-2xl font-semibold">{s.t}</h3>
          <p class="text-[15px] leading-relaxed text-muted">{s.d}</p>
          <a href={path(lang, s.h)} class="mt-auto font-mono text-xs text-accent hover:underline">{s.l}</a>
        </div>
      ))}
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="wrap scroll-mt-20 pb-24 pt-28">
    <div class="reveal relative flex flex-wrap items-end justify-between gap-10 overflow-hidden rounded-[28px] border border-line-2 bg-[#0f1411] p-[clamp(28px,6vw,80px)]">
      <div class="absolute -right-32 -top-32 h-[420px] w-[420px] rounded-full border border-[#22302a]" aria-hidden="true"></div>
      <div class="absolute -right-10 -top-10 h-[260px] w-[260px] rounded-full border border-[#22302a]" aria-hidden="true"></div>
      <div class="relative flex min-w-0 flex-[999_1_480px] flex-col gap-4">
        <span class="eyebrow">{t.s7}</span>
        <h2 class="font-display text-[clamp(40px,6vw,84px)] font-extrabold leading-[.95] tracking-[-0.03em]">{t.s7Title}</h2>
        <p class="max-w-[520px] text-lg leading-relaxed text-muted">{t.s7Lead}</p>
        <a href={path(lang, '/match')} class="self-start font-mono text-sm text-accent hover:underline">{t.matchCta}</a>
      </div>
      <div class="relative flex min-w-0 flex-[1_1_300px] flex-col gap-3">
        <a href={`mailto:${person.email}`} class="flex min-h-14 items-center justify-between gap-3 rounded-xl bg-accent px-5 font-semibold text-ink [overflow-wrap:anywhere] hover:bg-accent-2">{person.email}<Fragment set:html={ext} /></a>
        <button type="button" data-copy-email class="flex min-h-14 cursor-pointer items-center justify-between rounded-xl border border-[#2e3a33] px-5 text-fg hover:border-[#4a5a50]"><span data-copy-label>{t.copyEmail}</span><span class="font-mono text-xs text-faint">{t.clipboard}</span></button>
        <a href={person.linkedin} class="flex min-h-14 items-center justify-between rounded-xl border border-[#2e3a33] px-5 text-fg hover:border-[#4a5a50]">LinkedIn / sekkouri<Fragment set:html={ext} /></a>
        <a href={person.github} class="flex min-h-14 items-center justify-between rounded-xl border border-[#2e3a33] px-5 text-fg hover:border-[#4a5a50]">GitHub / MouaadSek<Fragment set:html={ext} /></a>
      </div>
    </div>
  </section>
</Base>
