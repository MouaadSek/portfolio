---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { ui, path, type Lang } from '../i18n';
import type { CaseStudy } from '../data/cases';

interface Props { c: CaseStudy; next: CaseStudy; lang: Lang }
const { c, next, lang } = Astro.props;
const t = ui[lang];
const levelClass = (v: string) =>
  ['CRITICAL', 'BLOCK', 'DENY', 'CRITIQUE', 'BLOQUÉ', 'REFUSÉ'].includes(v) ? 'text-[#ff8a5c]' : ['HIGH', 'ÉLEVÉ'].includes(v) ? 'text-amber' : ['HARDENED', 'DURCI'].includes(v) ? 'text-accent' : 'text-muted';
const sections = [t.secContext, t.secApproach, c.tableTitle, t.secOutcome, t.secLessons];
---
<Base lang={lang} title={`${c.title} · ${t.caseFile} ${c.id} · Mouaad Sekkouri`} description={c.outcome}>
  <div class="wrap flex flex-wrap items-center justify-between gap-4 pt-8">
    <a href={`${path(lang, '/')}#work`} class="inline-flex min-h-11 items-center gap-2.5 text-[15px] text-fg-2 hover:text-accent">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>{t.allCases}
    </a>
    <span class="font-mono text-[13px] text-faint">~/work/{c.id.toLowerCase()}$</span>
  </div>

  <header class="wrap flex flex-col gap-7 pb-12 pt-12">
    <div class="flex flex-wrap gap-2.5 font-mono text-xs">
      <span class="rounded-md border border-line-2 bg-[#151b17] px-3 py-1.5 text-accent">{c.id}</span>
      <span class="rounded-md bg-[#151b17] px-3 py-1.5 uppercase text-fg-2">{c.track}</span>
      <span class="rounded-md border border-[#3a2c10] bg-[#1e1708] px-3 py-1.5 text-amber">STATUS: {c.status}</span>
    </div>
    <h1 class="max-w-[1000px] font-display text-[clamp(42px,6vw,88px)] font-extrabold leading-[.98] tracking-[-0.03em]">{c.title}</h1>
    <p class="max-w-[760px] text-xl leading-relaxed text-muted">{c.outcome}</p>
    <dl class="mt-3 grid grid-cols-1 overflow-hidden rounded-2xl border border-line sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-1.5 bg-panel px-5 py-5"><dt class="font-mono text-xs text-faint">{t.role}</dt><dd>{c.meta.role}</dd></div>
      <div class="flex flex-col gap-1.5 border-t border-line bg-panel px-5 py-5 sm:border-l sm:border-t-0"><dt class="font-mono text-xs text-faint">{t.when}</dt><dd>{c.meta.when}</dd></div>
      <div class="flex flex-col gap-1.5 border-t border-line bg-panel px-5 py-5 lg:border-l lg:border-t-0"><dt class="font-mono text-xs text-faint">{t.stack}</dt><dd class="text-[15px]">{c.meta.stack}</dd></div>
      <div class="flex flex-col gap-1.5 border-t border-line bg-panel px-5 py-5 sm:border-l lg:border-t-0"><dt class="font-mono text-xs text-faint">{t.link}</dt><dd>{c.meta.link ? <a href={c.meta.link.href} class="break-all text-accent hover:underline">{c.meta.link.label}</a> : <span class="text-muted">{t.privateRepo}</span>}</dd></div>
    </dl>
  </header>

  <div class="wrap pb-20">
    <div class="h-[clamp(320px,42vw,520px)] overflow-hidden rounded-[22px] border border-line"><Art type={c.art} large /></div>
  </div>

  <div class="wrap flex flex-wrap gap-14 pb-24">
    <nav aria-label={t.sectionsLabel} class="flex-[1_1_220px]">
      <ol class="sticky top-24 flex flex-col gap-1 font-mono text-sm">
        {sections.map((s, i) => <li><a href={`#s${i + 1}`} class="flex min-h-11 items-center text-dim hover:text-accent">{String(i + 1).padStart(2, '0')} {s}</a></li>)}
      </ol>
    </nav>

    <article class="flex min-w-0 flex-[999_1_640px] flex-col gap-16">
      <section id="s1" class="reveal flex scroll-mt-24 flex-col gap-4">
        <span class="eyebrow">01 / {t.secContext.toUpperCase()}</span>
        <h2 class="font-display text-4xl font-bold">{t.problem}</h2>
        {c.context.map((p) => <p class="text-lg leading-[1.7] text-muted">{p}</p>)}
      </section>

      <section id="s2" class="reveal flex scroll-mt-24 flex-col gap-6">
        <span class="eyebrow">02 / {t.secApproach.toUpperCase()}</span>
        <h2 class="font-display text-4xl font-bold">{c.flowTitle}</h2>
        <ol class="flex flex-wrap items-center gap-3">
          {c.flow.map((step, i) => (
            <li class="flex items-center gap-3">
              <span class={`rounded-xl border px-4 py-3.5 font-mono text-sm ${i === c.flow.length - 1 ? 'border-accent bg-[#131a10] text-accent' : 'border-line-2 bg-panel text-fg'}`}>
                <span class="mr-2 text-faint">{String(i + 1).padStart(2, '0')}</span>{step}
              </span>
              {i < c.flow.length - 1 && <svg width="28" height="14" viewBox="0 0 28 14" fill="none" stroke="#3a4a40" stroke-width="2" aria-hidden="true"><path d="M0 7h24M19 2l5 5-5 5"></path></svg>}
            </li>
          ))}
        </ol>
      </section>

      <section id="s3" class="reveal flex scroll-mt-24 flex-col gap-6">
        <span class="eyebrow">03 / {c.tableTitle.toUpperCase()}</span>
        <h2 class="font-display text-4xl font-bold">{c.tableTitle}</h2>
        <div class="overflow-x-auto rounded-2xl border border-line">
          <table class="w-full min-w-[580px] border-collapse text-left text-[15px]">
            <thead class="bg-panel-2 font-mono text-xs text-faint"><tr class="border-b border-line">{c.tableHead.map((h) => <th scope="col" class="px-5 py-3.5 font-normal">{h}</th>)}</tr></thead>
            <tbody>
              {c.table.map(([a, b, v]) => (
                <tr class="border-b border-[#161c18] last:border-0">
                  <td class="px-5 py-4">{a}</td>
                  <td class="px-5 py-4 font-mono text-[13px] text-muted">{b}</td>
                  <td class={`px-5 py-4 font-mono text-[13px] ${levelClass(v)}`}>{v}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="s4" class="reveal flex scroll-mt-24 flex-col gap-6">
        <span class="eyebrow">04 / {t.secOutcome.toUpperCase()}</span>
        <h2 class="font-display text-4xl font-bold">{t.results}</h2>
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-3">
          {c.results.map((r) => (
            <div class="flex flex-col gap-1.5 rounded-2xl border border-line bg-panel p-6">
              <span class="font-display text-[42px] font-extrabold">{r.value}</span>
              <span class="text-sm text-dim">{r.label}</span>
            </div>
          ))}
        </div>
      </section>

      <section id="s5" class="reveal flex scroll-mt-24 flex-col gap-4">
        <span class="eyebrow">05 / {t.secLessons.toUpperCase()}</span>
        <h2 class="font-display text-4xl font-bold">{t.differently}</h2>
        <p class="text-lg leading-[1.7] text-muted">{c.lessons}</p>
      </section>

      <a href={path(lang, `/work/${next.slug}`)} class="spot card group flex flex-wrap items-center justify-between gap-4 p-7 text-fg">
        <span class="flex flex-col gap-1.5"><span class="font-mono text-xs text-faint">{t.nextCase} · {next.id}</span><span class="font-display text-[26px] font-semibold">{next.title}</span></span>
        <svg class="transition-transform group-hover:translate-x-1" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#b8f25a" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </article>
  </div>
</Base>
